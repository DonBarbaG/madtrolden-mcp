{
  "name": "madtrolden-mcp",
  "version": "0.6.0",
  "type": "module",
  "private": true,
  "description": "Remote MCP server for Danish grocery-deal meal planning on Vercel. Fork of tilbudstrolden-mcp by Olga Safonova (MIT). Search offers, plan budget-capped weeks, and generate deal-optimized shopping lists.",
  "author": "Ludwig Madsen Barbagallo",
  "contributors": [
    "Olga Safonova (original tilbudstrolden-mcp, https://github.com/olgasafonova/tilbudstrolden-mcp)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DonBarbaG/madtrolden-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "grocery",
    "deals",
    "tilbud",
    "danish",
    "etilbudsavis",
    "meal-planning",
    "shopping-list",
    "claude",
    "ai-tools"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:stdio": "tsx watch lib/server-stdio.ts",
    "start:stdio": "tsx lib/server-stdio.ts",
    "genkey": "tsx scripts/genkey.ts",
    "lint": "biome check lib/ app/ scripts/",
    "lint:fix": "biome check --write lib/ app/ scripts/",
    "format": "biome format --write lib/ app/ scripts/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "mcp-handler": "1.0.6",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "overrides": {
    "path-to-regexp": "^8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  }
}
